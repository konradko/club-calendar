# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec file for Club Calendar menu bar app."""

import subprocess
import tempfile
from pathlib import Path

# Get project root (deploy -> project root)
spec_dir = Path(SPECPATH)
project_root = spec_dir.parent
source_icon = spec_dir / "icon.png"  # Generated by build-icons.sh

block_cipher = None


def run_sips(args: list[str], description: str = "") -> bool:
    """Run sips command with error handling.

    Args:
        args: Command arguments for sips
        description: Description for error messages

    Returns:
        True if successful, False otherwise
    """
    result = subprocess.run(
        ["sips"] + args,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(f"WARNING: sips failed{f' ({description})' if description else ''}: {result.stderr}")
        return False
    return True


def run_iconutil(args: list[str]) -> bool:
    """Run iconutil command with error handling.

    Args:
        args: Command arguments for iconutil

    Returns:
        True if successful, False otherwise
    """
    result = subprocess.run(
        ["iconutil"] + args,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(f"WARNING: iconutil failed: {result.stderr}")
        return False
    return True


# Generate icons from high-res source at build time
def generate_icons():
    """Generate .icns and menubar template icons from icon.png."""
    if not source_icon.exists():
        print(f"WARNING: {source_icon} not found, icons will be missing")
        return []

    datas = []

    # Generate menubar template icons (22x22 and 44x44)
    for size, suffix in [(22, ""), (44, "@2x")]:
        out_path = spec_dir / f"icon_menubarTemplate{suffix}.png"
        # Resize
        if run_sips(["-z", str(size), str(size), str(source_icon), "--out", str(out_path)],
                    f"menubar {size}x{size}"):
            # Convert to black template (menubar icons should be black on transparent)
            run_sips(["--setProperty", "format", "png", str(out_path)], "set format")
            if out_path.exists():
                datas.append((str(out_path), "."))
                print(f"  Generated: {out_path.name} ({size}x{size})")

    # Generate .icns
    iconset = spec_dir / "icon.iconset"
    iconset.mkdir(exist_ok=True)

    # Icon size specifications: (size, output_name)
    icon_specs = [
        (16, "icon_16x16.png"),
        (32, "icon_16x16@2x.png"),
        (32, "icon_32x32.png"),
        (64, "icon_32x32@2x.png"),
        (128, "icon_128x128.png"),
        (256, "icon_128x128@2x.png"),
        (256, "icon_256x256.png"),
        (512, "icon_256x256@2x.png"),
        (512, "icon_512x512.png"),
        (1024, "icon_512x512@2x.png"),
    ]

    for size, out_name in icon_specs:
        run_sips(["-z", str(size), str(size), str(source_icon),
                  "--out", str(iconset / out_name)], f"iconset {out_name}")

    icns_path = spec_dir / "icon.icns"
    if run_iconutil(["-c", "icns", str(iconset), "-o", str(icns_path)]):
        print(f"  Generated: {icns_path.name}")

    # Cleanup iconset
    import shutil
    shutil.rmtree(iconset, ignore_errors=True)

    return datas

print("Generating icons from icon.png...")
datas = generate_icons()

a = Analysis(
    [str(project_root / "src" / "club_calendar" / "menubar" / "__main__.py")],
    pathex=[
        str(project_root / "src"),
        str(project_root / "packages" / "core" / "src"),
    ],
    binaries=[],
    datas=datas,
    hiddenimports=[
        "rumps",
        "club_calendar",
        "club_calendar.config",
        "club_calendar.models",
        "club_calendar.eventkit",
        "club_calendar_core",
        "club_calendar_core.strava",
        "club_calendar_core.service",
        "club_calendar_core.ports",
        "httpx",
        "yaml",
    ],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    win_no_prefer_redirects=False,
    win_private_assemblies=False,
    cipher=block_cipher,
    noarchive=False,
)

pyz = PYZ(a.pure, a.zipped_data, cipher=block_cipher)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="Club Calendar",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
)

coll = COLLECT(
    exe,
    a.binaries,
    a.zipfiles,
    a.datas,
    strip=False,
    upx=True,
    upx_exclude=[],
    name="Club Calendar",
)

icon_icns = spec_dir / "icon.icns"
app = BUNDLE(
    coll,
    name="Club Calendar.app",
    icon=str(icon_icns) if icon_icns.exists() else None,
    bundle_identifier="com.club-calendar.menubar",
    info_plist={
        "LSUIElement": True,  # Hide from Dock
        "CFBundleShortVersionString": "0.1.0",
        "NSHighResolutionCapable": True,
        "NSCalendarsUsageDescription": "Club Calendar syncs Strava club events to your calendar.",
    },
)
