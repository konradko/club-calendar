# Strava API credentials (from strava.com/settings/api)
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
STRAVA_REFRESH_TOKEN=your_refresh_token

# Club IDs to sync (comma-separated)
STRAVA_CLUB_IDS=123456,789012

# Optional: Timezone for scheduling
TZ=Europe/London

# Optional: Cron schedule (default: 4x daily)
SYNC_SCHEDULE=0 8,12,16,20 * * *

# Optional: Port for HTTP server
PORT=51470
